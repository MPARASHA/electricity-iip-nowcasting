      "08-15",
      "10-02"
    ],
    "diwali_window_days_each_side": 1,
    "heating_base_C": 18,
    "cooling_base_C": 24,
    "temperature_rule": "Compute positive-part HDD18 and CDD24 at each point, then take fixed weighted means.",
    "fit_end_rule": "Last released in-scope training label month end; exclude current unlabeled months.",
    "remove": "Annual Fourier, weekdays, fixed holidays, Diwali window and temperature. Keep intercept, trend and residual."
  },
